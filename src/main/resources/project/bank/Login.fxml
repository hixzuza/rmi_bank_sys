            <Button fx:id="empty_btn" layoutX="121.0" layoutY="192.0" mnemonicParsing="false" onAction="#Empty_btn" prefHeight="25.0" prefWidth="82.0" styleClass="c" stylesheets="@css/Login.css" text="EMPTY">
