         <children>
            <ImageView fitHeight="23.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@img/login.png" />
               </image>
               <HBox.margin>
                  <Insets left="9.0" top="9.0" />
               </HBox.margin>
            </ImageView>
            <Region prefHeight="43.0" prefWidth="103.0">
               <HBox.margin>
                  <Insets right="14.0" />
               </HBox.margin>
            </Region>
            <Label prefHeight="42.0" prefWidth="110.0" text="BanqueApp" textAlignment="RIGHT" textFill="#c99931">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #181818; -fx-border-radius: 2 0 2 0; -fx-border-color: #C9A84C;" BorderPane.alignment="CENTER">
         <children>
            <PasswordField fx:id="passField_login" layoutX="35.0" layoutY="128.0" prefHeight="28.0" prefWidth="189.0" style="-fx-background-color: #30302E; -fx-background-radius: 15; -fx-border-radius: 15;" stylesheets="@css/Login.css" />
            <TextField fx:id="TxtField_login" layoutX="37.0" layoutY="54.0" prefHeight="25.0" prefWidth="185.0" style="-fx-background-color: #30302E; -fx-background-radius: 15; -fx-border-radius: 15;" stylesheets="@css/Login.css" />
            <Label layoutX="47.0" layoutY="34.0" prefHeight="17.0" prefWidth="103.0" text="username" textFill="#c99931">
               <font>
