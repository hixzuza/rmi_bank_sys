<BorderPane maxHeight="300.0" maxWidth="360.0" minHeight="300.0" minWidth="360.0" prefHeight="300.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.bank.client.viewmodel.LoginVM">
