<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/ClientAllAcc.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.bank.client.viewmodel.ClientAllAccVM">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-header">
            <children>
                <Label styleClass="client-badge" text="CLIENT" />
                <Label fx:id="nomclient" styleClass="client-name" />
            </children>
        </HBox>
    </top>
    <center>
        <AnchorPane styleClass="anchor-pane" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="14.0" layoutY="10.0" styleClass="label-title" text="My Accounts" />
                <TableView fx:id="tableView" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="50.0">
                    <columns>
                        <TableColumn fx:id="colCompte" text="COMPTE" />
                        <TableColumn fx:id="colBalence" text="BALANCE" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </center>
</BorderPane>