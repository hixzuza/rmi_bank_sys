<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@css/ClientAllAcc.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.bank.client.viewmodel.AdminListAccVM">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="39.0" prefWidth="600.0" spacing="10" styleClass="top-header">
            <children>
                <Label styleClass="badge-label" text="ADMIN" />
                <Label fx:id="nomclient2" styleClass="client-name" />
            </children>
        </HBox>
    </top>
    <center>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tableView" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <columns>
                        <TableColumn fx:id="colClient" prefWidth="150.0" text="Client" />
                        <TableColumn fx:id="colNCompte" prefWidth="150.0" text="N compte" />
                        <TableColumn fx:id="colBalance" prefWidth="120.0" text="Balance" />
                        <TableColumn fx:id="dateCreation" prefWidth="170.0" text="Date creation" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </center>
</BorderPane>