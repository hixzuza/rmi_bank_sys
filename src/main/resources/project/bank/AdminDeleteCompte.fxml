<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="400.0" prefWidth="500.0" stylesheets="@css/AdminDeleteCompte.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.bank.client.viewmodel.AdminDeleteCompteVM">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-header">
            <children>
                <Label styleClass="badge-label" text="ADMIN" />
                <Label fx:id="adminName" styleClass="admin-name" />
            </children>
        </HBox>
    </top>

    <center>
        <AnchorPane styleClass="center-pane">
            <children>
                <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
                    <children>
                        <Label styleClass="form-title" text="DELETE ACCOUNT" />

                        <VBox spacing="15" styleClass="form-container">
                            <children>
                                <!-- Account Number Field -->
                                <VBox spacing="5">
                                    <Label styleClass="field-label" text="Account Number" />
                                    <TextField fx:id="accountNumberField" promptText="Enter account number" styleClass="text-field" />
                                </VBox>

                                <!-- Warning Message -->
                                <Label graphicTextGap="7.0" prefHeight="27.0" prefWidth="170.0" styleClass="warning-label" text="action cannot go back" textAlignment="CENTER" />
                            </children>
                        </VBox>

                        <!-- Buttons -->
                        <HBox alignment="CENTER" spacing="20">
                            <children>
                                <Button fx:id="deleteButton" onAction="#deleteAccount" styleClass="delete-button" text="DELETE" />
                                <Button fx:id="cancelButton" onAction="#cancel" styleClass="cancel-button" text="CANCEL" />
                            </children>
                        </HBox>

                        <!-- Status Label -->
                        <Label fx:id="statusLabel" styleClass="status-label" text="" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>
